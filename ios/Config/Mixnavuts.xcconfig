// 엔진 API 주소. 시뮬레이터에서는 이 Mac에서 띄운 `python -m mixnavuts serve`에 붙는다.
// 실기기에서는 Config/Local.xcconfig에 같은 이름으로 Mac의 IP를 넣는다. ("//"는 주석이라 "/$()/"로 쓴다)
MIXNAVUTS_API_URL = http:/$()/localhost:8080

// 지도 스타일. 기본은 엔진의 자체 지도(표준노드링크 벡터 타일 + 브이월드 배경). 비우면 Apple 지도(MapKit).
MIXNAVUTS_MAP_STYLE_URL = $(MIXNAVUTS_API_URL)/v1/style.json

// 개인 설정(주소)은 버전 관리하지 않는 Local.xcconfig에 둔다.
#include? "Local.xcconfig"
